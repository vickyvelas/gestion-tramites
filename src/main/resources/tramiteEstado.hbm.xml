<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="entidades.TramiteEstado" table="tramiteEstado">
        
        <id name="OID" type="string">
         <column name="OIDTramiteEstado"/>
         <generator class="uuid2"/>
        </id>
        
        <property name="nroLineaTramiteEstado" type="int" not-null="true">
            <column name="nroLineaTramiteEstado"/>
        </property>
        
        <property name="fechaHoraHastaTramiteEstado" type="timestamp" not-null="true" >
            <column name="fechaHoraHastaTramiteEstado"/>
        </property>
        
        <property name="fechaHoraDesdeTramiteEstado" type="timestamp" not-null="true" >
            <column name="fechaHoraDesdeTramiteEstado"/>
        </property>
        
        <property name="fechaHoraBajaTramiteEstado" type="timestamp" >
            <column name="fechaHoraBajaTramiteEstado"/>
        </property>
        
        <property name="observacionTramiteEstado" type="string" not-null="true">
         <column name="observacionTramiteEstado"/>
        </property>
        
    </class>
</hibernate-mapping>
